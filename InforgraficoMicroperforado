          boxShadow: {
            'custom': '0 10px 25px -5px rgba(55, 66, 150, 0.08), 0 8px 10px -6px rgba(55, 66, 150, 0.04)',
            'card-hover': '0 20px 30px -10px rgba(55, 66, 150, 0.15)'
          }
        }
      }
    }
  </script>

  <style>
    body {
      font-family: 'Inter', sans-serif;
      -webkit-font-smoothing: antialiased;
      background-color: #F1F5F9;
    }
    .font-display {
      font-family: 'Outfit', sans-serif;
    }
    @media print {
      body {
        background-color: #FFFFFF !important;
        padding: 0 !important;
      }
      .no-print {
        display: none !important;
      }
      .page-break {
        page-break-after: always;
      }
      .shadow-custom, .shadow-xl, .shadow-lg {
        box-shadow: none !important;
        border: 1px solid #E2E8F0 !important;
      }
    }
    /* Flow timeline connector line */
    .timeline-line {
      position: absolute;
      top: 52px;
      left: 28px;
      bottom: 20px;
      width: 4px;
      background: linear-gradient(to bottom, #374296, #56B13E);
      z-index: 1;
    }
    @media (min-width: 1024px) {
      .timeline-horizontal-line {
        position: absolute;
        top: 48px;
        left: 10%;
        right: 10%;
        height: 4px;
        background: linear-gradient(to right, #374296, #56B13E, #374296, #56B13E);
        z-index: 0;
      }
